# ===================================================================
# Конфигурация Telegram Remote Control
# Скопируйте данный файл в .env и укажите ваши фактические параметры.
# НЕ сохраняйте реальные секреты в репозитории!
# ===================================================================

# -------------------------------------------------------------------
# 1. Telegram Bot Settings
# -------------------------------------------------------------------
# Токен бота, полученный у @BotFather (формат: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=123456789:EXAMPLE_TOKEN_CHANGE_ME

# Список разрешённых Telegram user_id через запятую или в виде JSON-массива
ALLOWED_TELEGRAM_USERS=123456789,987654321

# Необязательный прокси для Telegram Bot API (HTTP или SOCKS5), если прямой доступ заблокирован
# Примеры: http://127.0.0.1:1372 или socks5://127.0.0.1:10808
TELEGRAM_PROXY=

# -------------------------------------------------------------------
# 2. Workspaces & Antigravity CLI Settings
# -------------------------------------------------------------------
# Разрешённые рабочие каталоги для выполнения задач CLI.
# Формат: JSON-словарь {"псевдоним": "абсолютный_путь"} или alias=path через запятую
ALLOWED_WORKSPACES={"backend": "C:\\dev\\my_project", "docs": "C:\\dev\\documentation"}

# Путь к исполняемому файлу Antigravity CLI (по умолчанию "agy", если добавлен в PATH)
ANTIGRAVITY_CLI_PATH=agy

# Максимальное время выполнения одной задачи в секундах (по умолчанию 3600 сек / 1 час)
TASK_EXECUTION_TIMEOUT_SECONDS=3600

# Интервал отправки сообщений о статусе работы активной задачи (по умолчанию 60 сек / 1 мин)
TASK_PROGRESS_INTERVAL_SECONDS=60

# Пробуждать ли дисплей при создании скриншота (предотвращает тёмные/устаревшие снимки при простое)
WAKE_DISPLAY_ON_SCREENSHOT=true

# Предотвращать ли выключение дисплея во время активного выполнения задачи агентом
PREVENT_DISPLAY_SLEEP_DURING_EXECUTION=true

# Время ожидания подтверждения интерактивного запуска в секундах (по умолчанию 120 сек / 2 мин)
CONFIRMATION_TIMEOUT_SECONDS=120

# Автоподтверждение прав инструментов (--dangerously-skip-permissions) при выполнении подтверждённых задач (по умолчанию false)
CLI_AUTO_APPROVE_PERMISSIONS=false

# Уровень глубины рассуждений модели (low, medium, high, xhigh, max). Рекомендуется low для быстрой работы
CLI_REASONING_EFFORT=low

# -------------------------------------------------------------------
# 3. Wake-on-LAN (WoL) Settings
# -------------------------------------------------------------------
# MAC-адрес сетевой карты целевого компьютера (формат: AA:BB:CC:DD:EE:FF или AA-BB-CC-DD-EE-FF)
# Оставьте пустым, если Wake-on-LAN не используется
TARGET_MAC_ADDRESS=

# Широковещательный IP-адрес локальной подсети (по умолчанию 255.255.255.255 или 192.168.1.255)
WOL_BROADCAST_IP=255.255.255.255

# UDP-порт Wake-on-LAN (стандартные порты: 9 или 7)
WOL_PORT=9

# -------------------------------------------------------------------
# 4. Controller & Windows Agent Communication (v2 Architecture)
# -------------------------------------------------------------------
# Режим развёртывания: "local" (монолитный запуск) или "distributed" (Android + Windows)
# - local: Контроллер и Исполнитель работают в одном процессе (для локальной разработки).
# - distributed: Android Controller и Windows Agent работают раздельно.
CONTROLLER_MODE=local

# Сетевой адрес и порт для связи между Контроллером и Агентом:
# - На Android Controller: укажите CONTROLLER_HOST=0.0.0.0 и CONTROLLER_PORT=8080
# - На Windows Agent: укажите CONTROLLER_HOST=<IP_адрес_Android_в_LAN_или_VPN> и CONTROLLER_PORT=8080
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=8080

# Секретный ключ взаимной аутентификации между Контроллером и Windows Agent (HMAC-SHA256).
# Минимум 16 символов. Должен быть абсолютно одинаковым на Android Controller и Windows Agent!
AGENT_AUTH_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY

# -------------------------------------------------------------------
# 5. Task Queue & SQLite Storage Settings
# -------------------------------------------------------------------
# Путь к файлу базы данных SQLite для постоянной очереди и истории задач
SQLITE_DATABASE_PATH=data/tasks.sqlite3

# Путь к каталогу для сохранения полных результатов выполнения задач
TASK_RESULTS_DIR=data/results

# Максимальный размер очереди ожидающих задач (по умолчанию 50)
MAX_QUEUE_SIZE=50

